        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml DisciplineManagementSystem_Simple\n\ntitle Discipline Management System - Simplified Class Diagram\n\nskinparam class {\n    BackgroundColor&lt;&lt;App&gt;&gt; #F8CECC\n    BackgroundColor&lt;&lt;API&gt;&gt; #F8CECC\n    BackgroundColor&lt;&lt;Layout&gt;&gt; #DAE8FC\n    BackgroundColor&lt;&lt;Page&gt;&gt; #D5E8D4\n    BackgroundColor&lt;&lt;UI&gt;&gt; #E1D5E7\n    BackgroundColor&lt;&lt;Form&gt;&gt; #FFF2CC\n}\n\nclass App &lt;&lt;App&gt;&gt; {\n    +router: Router\n    +toaster: Toaster\n    +isAuthenticated: boolean\n    +userRole: string\n    +render(): JSX\n}\n\nclass Layout &lt;&lt;Layout&gt;&gt; {\n    +sidebarCollapsed: boolean\n    +toggleSidebar(): void\n    +render(): JSX\n}\n\nclass Dashboard &lt;&lt;Page&gt;&gt; {\n    +loading: boolean\n    +stats: object\n    +loadDashboardData(): Promise&lt;void&gt;\n    +render(): JSX\n}\n\nclass Students &lt;&lt;Page&gt;&gt; {\n    +isModalOpen: boolean\n    +students: array\n    +handleAddStudent(): void\n    +handleEditStudent(): void\n    +handleDeleteStudent(): void\n    +render(): JSX\n}\n\nclass Reports &lt;&lt;Page&gt;&gt; {\n    +isReportModalOpen: boolean\n    +reports: array\n    +fetchReports(): Promise&lt;void&gt;\n    +handleCreateReport(): void\n    +render(): JSX\n}\n\nclass Forum &lt;&lt;Page&gt;&gt; {\n    +isPostModalOpen: boolean\n    +posts: array\n    +loadPosts(): Promise&lt;void&gt;\n    +handleCreatePost(): void\n    +render(): JSX\n}\n\nclass Card &lt;&lt;UI&gt;&gt; {\n    +title: string\n    +action: any\n    +render(): JSX\n}\n\nclass Modal &lt;&lt;UI&gt;&gt; {\n    +isOpen: boolean\n    +title: string\n    +onClose(): void\n    +render(): JSX\n}\n\nclass StudentForm &lt;&lt;Form&gt;&gt; {\n    +student: object\n    +hookForm: useForm\n    +onSave(data): void\n    +onCancel(): void\n    +render(): JSX\n}\n\nclass ReportForm &lt;&lt;Form&gt;&gt; {\n    +step: number\n    +hookForm: useForm\n    +onSave(data): void\n    +nextStep(): void\n    +render(): JSX\n}\n\nclass AuthAPI &lt;&lt;API&gt;&gt; {\n    +login(credentials): Promise\n    +logout(): Promise\n    +getCurrentUser(): Promise\n}\n\nclass DashboardAPI &lt;&lt;API&gt;&gt; {\n    +getStats(): Promise\n    +getChartData(): Promise\n    +getRecentIncidents(): Promise\n}\n\nclass ForumAPI &lt;&lt;API&gt;&gt; {\n    +getPosts(): Promise\n    +createPost(data): Promise\n    +likePost(id): Promise\n}\n\nclass ReportsAPI &lt;&lt;API&gt;&gt; {\n    +getAll(filters): Promise\n    +create(data): Promise\n    +exportPDF(reportId): Promise\n}\n\n&#39; Core Relationships\nApp \&quot;1\&quot; *-- \&quot;1\&quot; Layout : contains\nLayout \&quot;1\&quot; *-- \&quot;1\&quot; Header : contains\nLayout \&quot;1\&quot; *-- \&quot;1\&quot; Sidebar : contains\n\n&#39; Routing\nApp --&gt; Dashboard\nApp --&gt; Students\nApp --&gt; Reports\nApp --&gt; Forum\n\n&#39; Component Usage\nStudents ..&gt; StudentForm\nStudents ..&gt; Modal\nReports ..&gt; ReportForm\nReports ..&gt; Modal\nForum ..&gt; Modal\nDashboard ..&gt; Card\n\n&#39; API Calls\nDashboard ..&gt; DashboardAPI\nForum ..&gt; ForumAPI\nReports ..&gt; ReportsAPI\n\nnote right of App\n    &lt;b&gt;Legend:&lt;/b&gt;\n    Red = App/API\n    Blue = Layout\n    Green = Pages\n    Purple = UI\n    Yellow = Forms\nend note\n\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="_LRkWRcIWKqj1mn7JTsA-260">
